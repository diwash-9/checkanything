# CheckAnything environment variables
#
# These are SERVER-SIDE ONLY. Do not prefix them with VITE_ — anything prefixed
# with VITE_ is inlined into the client bundle and visible to every visitor.
#
# Copy this file to `.env` for local development and fill in real values.

# FX provider key for exchangerate-api.com (primary provider).
# Optional locally: without it, the server falls back to the keyless
# open.er-api.com provider. Required in production for reliable rates.
FX_API_KEY=
